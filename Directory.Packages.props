<Project>

  <!--
    Central package management: versions live here, projects reference by name only.
    Keeps Microsoft.Data.Sqlite identical across Core, the harness and tests, which
    matters because the FTS5 availability check depends on the SQLitePCLRaw bundle.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Bundle chosen explicitly: the default bundle_green does not enable FTS5. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
  </ItemGroup>

  <ItemGroup Label="Packaging">
    <!--
      Velopack, per Phase 10. The matching `vpk` command-line tool is pinned to the same
      version in scripts/publish.ps1: the two halves write and read the same package
      format, and a mismatch produces a release the installed app cannot apply.
    -->
    <PackageVersion Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Label="Graphics">
    <!-- D3D11 and DXGI bindings for the WGL_NV_DX_interop2 presentation path (decision 0002). -->
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
