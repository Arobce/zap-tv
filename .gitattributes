# Normalize line endings across platforms.
* text=auto eol=lf

*.sln text eol=crlf
*.slnx text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Fixtures are byte-exact inputs to the parsers; never let git rewrite them.
tests/Fixtures/** -text
*.m3u -text
*.m3u8 -text
*.xml -text
*.gz binary

*.dll binary
*.png binary
