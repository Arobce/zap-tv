<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Windows-specific: P/Invoke into libmpv, the render context, and GPU interop.
      Spike 0.1 established that the render API offers only "opengl" and "sw"; everything
      here is built behind IVideoPresenter so the backend stays swappable.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Iptv.Mpv</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    libmpv-2.dll is 120MB and is not committed. It is fetched into .local/native by
    scripts/fetch-libmpv.ps1 and copied to the output directory here so the harness, the
    app and the tests can load it. Override LibMpvPath to point elsewhere.

    Resolved per RID. Decision 0003 records why: the x64 binary in an ARM64 package fails
    at load time with an error that reads as a missing dependency rather than an
    architecture mismatch, so the two must never be able to reach the same output.
  -->
  <PropertyGroup>
    <LibMpvRoot>$(MSBuildThisFileDirectory)..\..\.local\native\mpv</LibMpvRoot>

    <!--
      A plain 'dotnet build' sets no RuntimeIdentifier, so the host's architecture is the
      only defensible guess: it is the only binary that could be loaded by anything this
      build produces.
    -->
    <LibMpvRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</LibMpvRid>
    <LibMpvRid Condition="'$(LibMpvRid)' == '' and '$(Platform)' == 'ARM64'">win-arm64</LibMpvRid>
    <LibMpvRid Condition="'$(LibMpvRid)' == ''">win-x64</LibMpvRid>

    <LibMpvPath Condition="'$(LibMpvPath)' == ''">$(LibMpvRoot)\$(LibMpvRid)\libmpv-2.dll</LibMpvPath>

    <!--
      The flat layout this project used before there were two of them. Kept as a fallback
      so an existing checkout keeps building, and only for x64, which is what a flat file
      there can only have been.
    -->
    <LibMpvPath Condition="!Exists('$(LibMpvPath)') and '$(LibMpvRid)' == 'win-x64' and Exists('$(LibMpvRoot)\libmpv-2.dll')">$(LibMpvRoot)\libmpv-2.dll</LibMpvPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(LibMpvPath)')">
    <None Include="$(LibMpvPath)">
      <Link>libmpv-2.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" />
  </ItemGroup>

  <!--
    A warning rather than an error: Iptv.Core and its tests must stay buildable on a
    machine with no native binaries, and CI builds this project without them.
  -->
  <Target Name="WarnIfLibMpvMissing" BeforeTargets="Build" Condition="!Exists('$(LibMpvPath)')">
    <Warning Code="IPTV0100" Text="libmpv-2.dll not found at '$(LibMpvPath)'. Playback code will build but cannot run. Fetch it with: pwsh ./scripts/fetch-libmpv.ps1 -Rid $(LibMpvRid)" />
  </Target>

</Project>
