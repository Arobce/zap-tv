<Window
    x:Class="Iptv.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iptv.App">

    <!--
        ZapTV. Electric yellow on near-black: the accent is a live wire, so it is used
        sparingly and only on things that are actually live, current or selected. Spreading
        it across every surface would make the one place it matters invisible.

        Named here rather than inline so the palette is one edit, not thirty.
    -->
    <!--
        Phase 6 vertical slice: one provider, the channel list, and playback. No EPG grid,
        no VOD, no settings. The PRD's advice is to use this as a TV for a week before
        starting the expensive UI work, because a harness proves throughput and tells you
        nothing about whether the thing is any good.

        Note: a double hyphen is illegal inside an XML comment, and the XAML compiler
        fails with no message at all when it meets one.
    -->
    <!--
        IsTabStop so the root can hold focus and receive key presses. Without it the
        shortcuts only work while some child happens to be focused, which in practice
        means they work right after clicking a channel and never again.
    -->
    <!-- Literal, not a StaticResource: this element owns the dictionary, and an attribute
         on it is set before its own Resources have been parsed. -->
    <Grid x:Name="RootGrid"
          Background="#FF12110D"
          IsTabStop="True"
          KeyDown="OnKeyDown">

        <!--
            On the root Grid, not the Window. A WinUI 3 Window is not a FrameworkElement
            and has no Resources property, and putting them there fails the XAML compiler
            with no message at all.
        -->
        <Grid.Resources>
            <!-- Arc yellow. The brightest thing on screen, reserved for the accent. -->
            <SolidColorBrush x:Key="ZapAccent" Color="#FFFFD21E" />
            <SolidColorBrush x:Key="ZapAccentDim" Color="#FFB8951A" />

            <!-- Warm-shifted neutrals. A true grey next to yellow reads as blue. -->
            <SolidColorBrush x:Key="ZapBackground" Color="#FF12110D" />
            <SolidColorBrush x:Key="ZapSurface" Color="#FF1A1813" />
            <SolidColorBrush x:Key="ZapOverlay" Color="#B8000000" />

            <SolidColorBrush x:Key="ZapText" Color="#FFF4F0E4" />
            <SolidColorBrush x:Key="ZapTextDim" Color="#FF938D7C" />
            <SolidColorBrush x:Key="ZapTextFaint" Color="#FF6B6659" />
            <SolidColorBrush x:Key="ZapTrack" Color="#FF2E2A21" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Sidebar" Grid.Column="0" Background="{StaticResource ZapSurface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="16,14" Spacing="10">
                <!-- The accent's one guaranteed appearance. Everything else earns it by
                     being live, current or selected. -->
                <TextBlock FontSize="21" FontWeight="Bold" Margin="0,0,0,2">
                    <Run Text="ZAP" Foreground="{StaticResource ZapAccent}" />
                    <Run Text="TV" Foreground="{StaticResource ZapText}" />
                </TextBlock>

                <TextBlock x:Name="LibraryText"
                           Text="loading library..."
                           FontSize="12"
                           Foreground="{StaticResource ZapTextDim}" />

                <!-- Three catalogues, one list. Live, films and series differ enough in
                     shape to need separate queries but not separate views. -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="LiveTab" Content="Live" Click="OnModeClicked" Tag="Live" />
                    <Button x:Name="FilmsTab" Content="Films" Click="OnModeClicked" Tag="Film" />
                    <Button x:Name="SeriesTab" Content="Series" Click="OnModeClicked" Tag="Series" />
                </StackPanel>

                <!-- The provider groups its own catalogue, and with 118,763 entries that
                     grouping is the only thing that makes the library browsable. -->
                <ComboBox x:Name="CategoryBox"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="All categories"
                          SelectionChanged="OnCategoryChanged" />

                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search"
                         TextChanged="OnSearchChanged" />
            </StackPanel>

            <!--
                ItemsRepeater in a ScrollViewer, per the PRD: a plain ListView does not
                hold up at 20,000 rows.
            -->
            <ScrollViewer Grid.Row="1" Padding="8,0,8,0">
                <ItemsRepeater x:Name="ChannelList">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:LibraryRow">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,8"
                                    Margin="0,1"
                                    Click="OnRowClicked"
                                    Tag="{x:Bind Key}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="14"
                                               Foreground="{StaticResource ZapText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               FontSize="11"
                                               Foreground="{StaticResource ZapTextDim}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{x:Bind ProgressPercent}"
                                                 Maximum="100"
                                                 Height="2"
                                                 Foreground="{StaticResource ZapAccent}"
                                                 Background="{StaticResource ZapTrack}"
                                                 Visibility="{x:Bind ProgressVisibility}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       x:Name="CountText"
                       Padding="16,10"
                       FontSize="11"
                       Foreground="{StaticResource ZapTextFaint}" />
        </Grid>

        <Grid Grid.Column="1">
            <SwapChainPanel x:Name="VideoPanel" DoubleTapped="OnVideoDoubleTapped" />

            <!-- Auto-hiding overlay would come later; always visible in the slice. -->
            <Border x:Name="TitleOverlay"
                    VerticalAlignment="Top"
                    Background="{StaticResource ZapOverlay}"
                    Padding="20,14">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="ChannelTitle"
                               Text="Select a channel"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock x:Name="ProgrammeTitle"
                               FontSize="13"
                               Foreground="{StaticResource ZapTextDim}" />
                    <TextBlock Text="F fullscreen · Space pause · ↑↓ channel · ←→ volume · M mute · B favourite"
                               FontSize="11"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource ZapTextFaint}" />
                </StackPanel>
            </Border>

            <!-- Volume and pause feedback, shown briefly on change then hidden. -->
            <Border x:Name="ToastPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{StaticResource ZapOverlay}"
                    CornerRadius="8"
                    Padding="28,18"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToastText"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="White" />
            </Border>

            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Background="{StaticResource ZapOverlay}"
                    CornerRadius="6"
                    Padding="14,9"
                    Margin="16">
                <TextBlock x:Name="StatusText"
                           Text="idle"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource ZapAccentDim}" />
            </Border>
        </Grid>
    </Grid>
</Window>
