<Window
    x:Class="Iptv.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iptv.App"
    xmlns:vm="using:Iptv.Presentation">

    <!--
        ZapTV. Electric yellow on near-black: the accent is a live wire, so it is used
        sparingly and only on things that are actually live, current or selected. Spreading
        it across every surface would make the one place it matters invisible.

        Named here rather than inline so the palette is one edit, not thirty.
    -->
    <!--
        Phase 6 vertical slice: one provider, the channel list, and playback. No EPG grid,
        no VOD, no settings. The PRD's advice is to use this as a TV for a week before
        starting the expensive UI work, because a harness proves throughput and tells you
        nothing about whether the thing is any good.

        Note: a double hyphen is illegal inside an XML comment, and the XAML compiler
        fails with no message at all when it meets one.
    -->
    <!--
        IsTabStop so the root can hold focus and receive key presses. Without it the
        shortcuts only work while some child happens to be focused, which in practice
        means they work right after clicking a channel and never again.
    -->
    <!-- Literal, not a StaticResource: this element owns the dictionary, and an attribute
         on it is set before its own Resources have been parsed. -->
    <Grid x:Name="RootGrid"
          Background="#FF12110D"
          IsTabStop="True"
          KeyDown="OnKeyDown">

        <!--
            On the root Grid, not the Window. A WinUI 3 Window is not a FrameworkElement
            and has no Resources property, and putting them there fails the XAML compiler
            with no message at all.
        -->
        <Grid.Resources>
            <!-- Arc yellow. The brightest thing on screen, reserved for the accent. -->
            <SolidColorBrush x:Key="ZapAccent" Color="#FFFFD21E" />
            <SolidColorBrush x:Key="ZapAccentDim" Color="#FFB8951A" />

            <!-- Warm-shifted neutrals. A true grey next to yellow reads as blue. -->
            <SolidColorBrush x:Key="ZapBackground" Color="#FF12110D" />
            <SolidColorBrush x:Key="ZapSurface" Color="#FF1A1813" />
            <SolidColorBrush x:Key="ZapOverlay" Color="#B8000000" />

            <SolidColorBrush x:Key="ZapText" Color="#FFF4F0E4" />
            <SolidColorBrush x:Key="ZapTextDim" Color="#FF938D7C" />
            <SolidColorBrush x:Key="ZapTextFaint" Color="#FF6B6659" />
            <SolidColorBrush x:Key="ZapTrack" Color="#FF2E2A21" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Sidebar" Grid.Column="0" Background="{StaticResource ZapSurface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="16,14" Spacing="10">
                <!-- The accent's one guaranteed appearance. Everything else earns it by
                     being live, current or selected. -->
                <Grid>
                    <TextBlock FontSize="21" FontWeight="Bold" Margin="0,0,0,2">
                        <Run Text="ZAP" Foreground="{StaticResource ZapAccent}" />
                        <Run Text="TV" Foreground="{StaticResource ZapText}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                    <Button Content="Guide"
                            Padding="10,4"
                            FontSize="12"
                            Click="OnOpenEpgClicked" />
                    <Button Content="Providers"
                            Padding="10,4"
                            FontSize="12"
                            Click="OnOpenProvidersClicked" />
                    <Button Content="?"
                            Padding="10,4"
                            FontSize="12"
                            ToolTipService.ToolTip="Diagnostics"
                            Click="OnOpenDiagnosticsClicked" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="LibraryText"
                           Text="loading library..."
                           FontSize="12"
                           Foreground="{StaticResource ZapTextDim}" />

                <!-- Three catalogues, one list. Live, films and series differ enough in
                     shape to need separate queries but not separate views. -->
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button x:Name="AllTab" Content="All" Click="OnModeClicked" Tag="All" Padding="10,5"
                            ToolTipService.ToolTip="Search everything at once" />
                    <Button x:Name="LiveTab" Content="Live" Click="OnModeClicked" Tag="Live" Padding="10,5" />
                    <Button x:Name="FilmsTab" Content="Films" Click="OnModeClicked" Tag="Films" Padding="10,5" />
                    <Button x:Name="SeriesTab" Content="Series" Click="OnModeClicked" Tag="Series" Padding="10,5" />

                    <!-- The payoff for the B key and for resume: without somewhere to see
                         them, marking a favourite and keeping a position both go nowhere. -->
                    <Button x:Name="FavouritesTab" Content="★" Click="OnModeClicked" Tag="Favourites"
                            Padding="10,5" ToolTipService.ToolTip="Favourites" />
                    <Button x:Name="ContinueTab" Content="▶" Click="OnModeClicked" Tag="Continue"
                            Padding="10,5" ToolTipService.ToolTip="Continue watching" />
                </StackPanel>

                <!-- The provider groups its own catalogue, and with 118,763 entries that
                     grouping is the only thing that makes the library browsable. -->
                <ComboBox x:Name="CategoryBox"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="All categories"
                          SelectionChanged="OnCategoryChanged" />

                <!-- Each tab searches what it lists; the All tab searches everything. -->
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search"
                         TextChanged="OnSearchChanged" />
            </StackPanel>

            <!--
                ItemsRepeater in a ScrollViewer, per the PRD: a plain ListView does not
                hold up at 20,000 rows.
            -->
            <ScrollViewer Grid.Row="1" Padding="8,0,8,0">
                <ItemsRepeater x:Name="ChannelList">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryRow">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,8"
                                    Margin="0,1"
                                    Click="OnRowClicked"
                                    Tag="{x:Bind Key}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="14"
                                               Foreground="{StaticResource ZapText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               FontSize="11"
                                               Foreground="{StaticResource ZapTextDim}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{x:Bind ProgressPercent}"
                                                 Maximum="100"
                                                 Height="2"
                                                 Foreground="{StaticResource ZapAccent}"
                                                 Background="{StaticResource ZapTrack}"
                                                 Visibility="{x:Bind local:Bindings.Show(ShowProgress)}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       x:Name="CountText"
                       Padding="16,10"
                       FontSize="11"
                       Foreground="{StaticResource ZapTextFaint}" />
        </Grid>

        <Grid Grid.Column="1">
            <SwapChainPanel x:Name="VideoPanel" DoubleTapped="OnVideoDoubleTapped" />

            <!-- Auto-hiding overlay would come later; always visible in the slice. -->
            <Border x:Name="TitleOverlay"
                    VerticalAlignment="Top"
                    Background="{StaticResource ZapOverlay}"
                    Padding="20,14">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="ChannelTitle"
                               Text="Select a channel"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock x:Name="ProgrammeTitle"
                               FontSize="13"
                               Foreground="{StaticResource ZapTextDim}" />
                    <TextBlock Text="F fullscreen · Space pause · ↑↓ channel · ←→ volume · M mute · B favourite"
                               FontSize="11"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource ZapTextFaint}" />
                </StackPanel>
            </Border>

            <!-- Volume and pause feedback, shown briefly on change then hidden. -->
            <Border x:Name="ToastPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{StaticResource ZapOverlay}"
                    CornerRadius="8"
                    Padding="28,18"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToastText"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="White" />
            </Border>

            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Background="{StaticResource ZapOverlay}"
                    CornerRadius="6"
                    Padding="14,9"
                    Margin="16">
                <TextBlock x:Name="StatusText"
                           Text="idle"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource ZapAccentDim}" />
            </Border>
        </Grid>

        <!--
            Diagnostics. The PRD notes nothing on the market has this; every number in it
            already existed and had nowhere to be seen.
        -->
        <Grid x:Name="DiagnosticsPanel"
              Grid.ColumnSpan="2"
              Background="{StaticResource ZapBackground}"
              Visibility="Collapsed">
            <ScrollViewer Padding="40,32">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,10">
                        <TextBlock Text="Diagnostics" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource ZapText}" />
                        <Button Content="Refresh" Click="OnRefreshDiagnosticsClicked"
                                Padding="10,4" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="Close" Click="OnCloseDiagnosticsClicked"
                                Padding="10,4" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="DiagnosticsContent" Spacing="4" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--
            The guide. Two axes of virtualization: the body is a Canvas sized to the whole
            guide, and only the blocks in view are realized onto it. Nothing here binds to
            a collection, because a collection of 164,661 programmes is the thing being
            avoided.
        -->
        <Grid x:Name="EpgPanel"
              Grid.ColumnSpan="2"
              Background="{StaticResource ZapBackground}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        Padding="16,12" Spacing="14">
                <TextBlock Text="Guide" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource ZapText}" />
                <TextBlock x:Name="EpgSummary" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource ZapTextDim}" />
                <Button Content="Now" Click="OnEpgNowClicked" Padding="10,4" FontSize="12" />
                <Button Content="Close" Click="OnCloseEpgClicked" Padding="10,4" FontSize="12" />
            </StackPanel>

            <!-- The corner is empty on purpose: it is where the two headers meet. -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource ZapSurface}" />

            <!--
                The time header and the channel column scroll with the body rather than
                with the pointer, so their scrollbars are off and their offsets are driven
                from the body's ViewChanged.
            -->
            <ScrollViewer x:Name="EpgHeaderScroll" Grid.Row="1" Grid.Column="1"
                          HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          Background="{StaticResource ZapSurface}">
                <Canvas x:Name="EpgHeaderCanvas" Height="28" />
            </ScrollViewer>

            <ScrollViewer x:Name="EpgChannelScroll" Grid.Row="2" Grid.Column="0"
                          HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          Background="{StaticResource ZapSurface}">
                <Canvas x:Name="EpgChannelCanvas" Width="220" />
            </ScrollViewer>

            <ScrollViewer x:Name="EpgBodyScroll" Grid.Row="2" Grid.Column="1"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ZoomMode="Disabled"
                          ViewChanged="OnEpgViewChanged">
                <Canvas x:Name="EpgBodyCanvas" />
            </ScrollViewer>

            <TextBlock x:Name="EpgEmptyText"
                       Grid.Row="2" Grid.Column="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" TextWrapping="Wrap" MaxWidth="460"
                       TextAlignment="Center"
                       Foreground="{StaticResource ZapTextDim}"
                       Visibility="Collapsed" />
        </Grid>

        <!--
            Providers. Spans both columns and sits above everything, because on a first run
            there is no library to be behind it and nothing else the user can usefully do.
        -->
        <Grid x:Name="ProvidersPanel"
              Grid.ColumnSpan="2"
              Background="{StaticResource ZapBackground}"
              Visibility="Collapsed">
            <ScrollViewer Padding="40,32">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="18">
                    <TextBlock Text="Providers" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource ZapText}" />

                    <TextBlock x:Name="ProvidersIntro"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource ZapTextDim}" />

                    <ItemsRepeater x:Name="ProviderList">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderCard">
                                <Border Background="{StaticResource ZapSurface}"
                                        CornerRadius="6"
                                        Padding="16,12"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ZapText}" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource ZapTextDim}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Sync now" Click="OnSyncProviderClicked"
                                                    Tag="{x:Bind Id}" Padding="12,6" />
                                            <Button Content="{x:Bind EnableLabel}" Click="OnToggleProviderClicked"
                                                    Tag="{x:Bind Id}" Padding="12,6" />
                                            <Button Content="Remove" Click="OnDeleteProviderClicked"
                                                    Tag="{x:Bind Id}" Padding="12,6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock Text="Add a provider" FontSize="18" FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource ZapText}" />

                    <StackPanel Spacing="10">
                        <TextBox x:Name="ProviderNameBox" Header="Name" PlaceholderText="My provider" />
                        <TextBox x:Name="ProviderHostBox" Header="Host"
                                 PlaceholderText="http://example.com:8080" />
                        <TextBox x:Name="ProviderUserBox" Header="Username" />
                        <PasswordBox x:Name="ProviderPassBox" Header="Password" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Test before Add, and to its left: the PRD wants Test to be
                                 the first impression, and it explains rather than passing. -->
                            <Button x:Name="TestProviderButton" Content="Test" Click="OnTestProviderClicked"
                                    Padding="16,7" />
                            <Button x:Name="AddProviderButton" Content="Add" Click="OnAddProviderClicked"
                                    Padding="16,7" />
                            <Button Content="Close" Click="OnCloseProvidersClicked" Padding="16,7" />
                        </StackPanel>

                        <TextBlock x:Name="ProviderResultText"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ZapAccent}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
