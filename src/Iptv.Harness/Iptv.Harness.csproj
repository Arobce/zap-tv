<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Console harness for timing ingest and running playback smoke tests, per the PRD.
      Targets -windows because it references Iptv.Mpv for the playback commands.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Iptv.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iptv.Core\Iptv.Core.csproj" />
    <ProjectReference Include="..\Iptv.Mpv\Iptv.Mpv.csproj" />

    <!--
      For the diagnostics command, which prints the view model's own output rather than a
      second copy of it. A headless check that computed its own numbers could agree with
      itself while disagreeing with the panel.
    -->
    <ProjectReference Include="..\Iptv.Presentation\Iptv.Presentation.csproj" />
  </ItemGroup>

</Project>
